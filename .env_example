# ==============================================================================
# Event-Driven Account Management Platform - Backend Environment Configuration
# ==============================================================================
# Copy this file to .env and configure your service credentials.

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database (Aiven for PostgreSQL)
# ------------------------------------------------------------------------------
# Option A: Direct Service URI from Aiven console (Recommended)
# Format: postgresql+asyncpg://avnadmin:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?ssl=require
DATABASE_URL=postgresql+asyncpg://avnadmin:your-aiven-password@pg-service-name.aivencloud.com:12345/defaultdb?ssl=require

# Option B: Individual connection parameters
# DB_HOST=pg-service-name.aivencloud.com
# DB_PORT=12345
# DB_USERNAME=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_DATABASE=defaultdb
# DB_SSL=True
# DB_SSLMODE=require

# ------------------------------------------------------------------------------
# 2. Apache Kafka Broker (Aiven for Apache Kafka)
# ------------------------------------------------------------------------------
# Kafka service bootstrap URI from Aiven (e.g. kafka-service-name.aivencloud.com:12346)
MESSAGE_BROKER_BOOTSTRAP_SERVERS=kafka-service-name.aivencloud.com:12346

# --- Kafka Authentication Mode 1: mTLS / Client Certificates (Aiven Default) ---
# Place ca.pem, service.cert, and service.key in .certs/aiven/ (auto-detected), or specify:
MESSAGE_BROKER_SECURITY_PROTOCOL=SSL
MESSAGE_BROKER_SSL_CAFILE=.certs/aiven/ca.pem
MESSAGE_BROKER_SSL_CERTFILE=.certs/aiven/service.cert
MESSAGE_BROKER_SSL_KEYFILE=.certs/aiven/service.key

# --- Kafka Authentication Mode 2: SASL_SSL (If user authentication is enabled in Aiven) ---
# MESSAGE_BROKER_SECURITY_PROTOCOL=SASL_SSL
# MESSAGE_BROKER_SASL_MECHANISM=SCRAM-SHA-256
# MESSAGE_BROKER_SASL_USERNAME=avnadmin
# MESSAGE_BROKER_SASL_PASSWORD=your-kafka-password
# MESSAGE_BROKER_SSL_CAFILE=.certs/aiven/ca.pem

# ------------------------------------------------------------------------------
# 3. Redis / Caching & Rate Limiting (Aiven for Caching / Redis)
# ------------------------------------------------------------------------------
# Option A: Direct Redis URI with TLS (rediss://)
REDIS_URL=rediss://default:your-redis-password@redis-service-name.aivencloud.com:12347

# Option B: Individual connection parameters
# REDIS_HOST=redis-service-name.aivencloud.com
# REDIS_PORT=12347
# REDIS_PASSWORD=your-redis-password
# REDIS_SSL=True

# ------------------------------------------------------------------------------
# 4. SMTP / Email Notifications
# ------------------------------------------------------------------------------
# Configure any cloud SMTP service (e.g. SendGrid, Brevo, Mailgun, AWS SES, or custom SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USE_TLS=False
SMTP_SENDER=noreply@yourdomain.com
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key

# ------------------------------------------------------------------------------
# 5. JWT Authentication Settings
# ------------------------------------------------------------------------------
# RSA keypair: Auto-generated on first startup into .certs/ if not present.
JWT_ALGORITHM=RS256
JWT_EXPIRATION=30

# ------------------------------------------------------------------------------
# 6. Email Verification (External API, optional)
# ------------------------------------------------------------------------------
EMAIL_VERIFIER_API_KEY=
EMAIL_VERIFIER_ENABLED=False

# ------------------------------------------------------------------------------
# 7. Server & CORS Configuration
# ------------------------------------------------------------------------------
UVICORN_SERVER_HOST=0.0.0.0
UVICORN_SERVER_PORT=8080
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]
